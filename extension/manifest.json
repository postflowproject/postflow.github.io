{
  "manifest_version": 3,
  "name": "PostFlow Group Post Helper",
  "version": "0.2.0",
  "description": "Prepare Facebook group posts and choose groups from your open Facebook tab.",
  "permissions": ["storage", "tabs", "activeTab"],
  "host_permissions": ["https://www.facebook.com/*"],
  "action": {"default_title":"PostFlow Group Helper","default_popup":"popup.html"},
  "content_scripts": [{"matches":["https://www.facebook.com/*"],"js":["content.js"],"run_at":"document_idle"}]
}